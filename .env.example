# Copier ce fichier en .env pour configurer l'environnement local.
# Ces variables doivent être préfixées EXPO_PUBLIC_ pour être exposées au bundle client.

# true = utiliser les fixtures locales (src/fixtures/off) au lieu de l'API réseau.
# Laisser à false (ou absent) pour appeler la vraie API Open Food Facts.
EXPO_PUBLIC_USE_FIXTURES=false
